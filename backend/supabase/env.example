# =============================================================================
# THERMO AI — Edge Function secrets template (DO NOT COMMIT REAL VALUES)
# File: backend/supabase/env.example
# (Named without a leading dot so it can be saved in the iOS Files app.)
# Copy to backend/supabase/secrets.env, fill in real values, then upload with:
#   supabase secrets set --env-file backend/supabase/secrets.env
# SUPABASE_URL / SUPABASE_ANON_KEY are injected automatically into Edge Functions.
# =============================================================================

GEMINI_API_KEY=replace-with-google-ai-studio-key
# Verify the current stable model ID at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash
AI_FREE_DAILY_LIMIT=25
AI_PRO_DAILY_LIMIT=300

# verify-subscription (App Store Server API, In-App Purchase key)
APPSTORE_ISSUER_ID=00000000-0000-0000-0000-000000000000
APPSTORE_KEY_ID=ABCDE12345
APPSTORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-p8-contents\n-----END PRIVATE KEY-----"
APPSTORE_BUNDLE_ID=com.example.thermoai
